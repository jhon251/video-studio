{
  "workspace": {
    "root": "projects"
  },
  "llm": {
    "provider": "deepseek",
    "deepseek": {
      "api_key_env": "DEEPSEEK_API_KEY",
      "base_url": "https://api.deepseek.com",
      "timeout_s": 120,
      "max_retries": 2,
      "backoff_base_s": 5
    },
    "tiers": {
      "R": {
        "model": "deepseek-v4-pro",
        "max_tokens": 8192
      },
      "M": {
        "model": "deepseek-flash",
        "max_tokens": 16384
      },
      "F": {
        "model": "deepseek-flash",
        "max_tokens": 2048
      }
    },
    "pricing": {
      "deepseek-flash": {
        "peak": {
          "cache_hit": 0.006,
          "cache_miss": 0.3,
          "output": 1.2
        },
        "off_peak": {
          "cache_hit": 0.003,
          "cache_miss": 0.15,
          "output": 0.6
        }
      },
      "deepseek-v4-pro": {
        "peak": {
          "cache_hit": 0.044,
          "cache_miss": 1.32,
          "output": 3.96
        },
        "off_peak": {
          "cache_hit": 0.022,
          "cache_miss": 0.66,
          "output": 1.98
        }
      }
    },
    "max_total_usd": 0.6
  },
  "tools": {
    "ffmpeg": {
      "path": "C:/mp4agent/video-studio/bin/ffmpeg.exe",
      "ffprobe": "C:/mp4agent/video-studio/bin/ffprobe.exe"
    },
    "tts": {
      "provider": "edge-tts",
      "voice_type": "zh-CN-XiaoxiaoNeural"
    },
    "asr": {
      "provider": "faster-whisper"
    },
    "search": {
      "provider": "none",
      "api_key_env": "SEARCH_API_KEY"
    },
    "image": {
      "provider": "none",
      "api_key_env": "IMAGE_API_KEY"
    },
    "video": {
      "provider": "none",
      "api_key_env": "VIDEO_API_KEY"
    },
    "material": {
      "provider": "wikimedia_commons",
      "search_limit": 8,
      "max_bytes": 8388608,
      "timeout_s": 25,
      "min_interval_s": 3.0,
      "rate_limit_retries": 3,
      "rate_limit_backoff_s": 10.0,
      "max_retries": 2,
      "max_concurrent_downloads": 2,
      "max_cache_bytes": 268435456,
      "allowed_ext": [
        ".jpg",
        ".jpeg",
        ".png",
        ".webp"
      ],
      "min_width": 320,
      "min_height": 180,
      "min_asset_width": 320,
      "min_asset_height": 180,
      "license_required": true,
      "require_https": true,
      "query_term_limit": 4,
      "query_max_chars": 100,
      "auth": {
        "mode": "none",
        "api_key_env": "WIKIMEDIA_API_TOKEN",
        "require_key": false
      }
    }
  },
  "hitl": {
    "gates": [
      "topic",
      "structure",
      "script",
      "materials",
      "final_cut",
      "publish"
    ],
    "auto_approve": false
  },
  "retry": {
    "default_max_retries": 2,
    "backoff_base_s": 5
  }
}