  "policy_source": "src/video_studio/core/integrity.py:DEFAULT_POLICY / DEFAULT_GATE_POLICY",
  "v9_project_id": "p_96efdc03e1aa",
  "v9_film_task": "t_d0a54bdf1810"
 },
 "state_reachability": {
  "note": "按源码实测：某些 PI 在实现里**不存在**某状态的返回路径，属设计事实（不是未覆盖）；M3 不伪造这些状态。",
  "PI-1": {
   "PASS": true,
   "FAIL": true,
   "UNKNOWN": false,
   "NOT_ASSESSABLE": true
  },
  "PI-2": {
   "PASS": true,
   "FAIL": true,
   "UNKNOWN": false,
   "NOT_ASSESSABLE": true
  },
  "PI-3": {
