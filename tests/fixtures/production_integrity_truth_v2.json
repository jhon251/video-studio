{
 "schema": "production-integrity-truth-v2",
 "stage": "6-A/M3",
 "purpose": "Production Integrity（PI-1…PI-6）冻结真值集：覆盖 PASS/FAIL/UNKNOWN/NOT_ASSESSABLE 四态与阈值边界，并把 6-A/M2 接线的门禁语义（渲染前/渲染后是否阻断、旁路是否留痕、旁路后是否仍有纵深防线）固化为可长期回归的期望值。",
 "frozen_policy": {
  "min_narration_coverage": 0.9,
  "max_shortfall_s": 30.0,
  "max_shortfall_ratio": 0.1,
  "max_silence_block_s": 8.0,
  "max_silence_ratio": 0.1,
  "max_tail_silence_s": 5.0,
  "silence_noise_db": -45,
  "silence_min_dur_s": 2.0,
  "max_av_track_delta_s": 1.0,
  "max_video_timeline_delta_s": 1.0,
  "max_start_delta_s": 0.5,
  "max_frame_count_delta": 1,
  "max_orphan_share": 0.02,
  "min_cue_over_narration": 0.6,
  "max_cue_over_narration": 1.1,
  "max_segment_drift_s": 5.0
 },
 "frozen_gate_flags": {
  "gate_enabled": true,
  "post_render_enabled": true,
  "block_on_unknown": true,
  "block_on_unknown_pi6": false
 },
 "references": {
  "m1_truth_set": "tests/fixtures/production_integrity_truth_v1.json",
  "m2_suite": "tests/integrity_gates_test.py",
