   "FAIL": true,
   "UNKNOWN": true,
   "NOT_ASSESSABLE": true
  },
  "PI-4": {
   "PASS": true,
   "FAIL": true,
   "UNKNOWN": true,
   "NOT_ASSESSABLE": true
  },
  "PI-5": {
   "PASS": true,
   "FAIL": true,
   "UNKNOWN": false,
   "NOT_ASSESSABLE": true
  },
  "PI-6": {
   "PASS": true,
   "FAIL": true,
   "UNKNOWN": true,
   "NOT_ASSESSABLE": true
  }
 },
 "gate_semantics": {
  "note": "M2 接线后的权威语义：四道 hard gate（PI-1/PI-2/PI-3/PI-5）与 PI-4 在 FAIL 或不可证时 fail-closed 阻断；PI-6 明确违约阻断、不可评估仅记录（绝不记 PASS）。",
  "pre_render_blocks_on": [
   "PI-1:FAIL",
   "PI-1:NOT_ASSESSABLE",
   "PI-2:FAIL",
   "PI-2:NOT_ASSESSABLE",
   "PI-6:FAIL"
  ],
  "pre_render_records_only": [
   "PI-6:UNKNOWN",
   "PI-6:NOT_ASSESSABLE"
  ],
  "post_render_blocks_on": [
   "PI-3:FAIL",
   "PI-3:UNKNOWN",
   "PI-3:NOT_ASSESSABLE",
   "PI-4:FAIL",
   "PI-4:UNKNOWN",
   "PI-4:NOT_ASSESSABLE",
   "PI-5:FAIL(orphan)",
   "PI-5:NOT_ASSESSABLE(有旁白计划)"
  ],
  "post_render_records_only": [
   "PI-5:coverage_fail",
   "PI-5:NOT_ASSESSABLE(无旁白计划)"
  ],
  "defense_in_depth": "关闭渲染前硬门**不等于**可以交付短旁白成片：短旁白必然在成片留下 >10% 的尾静音，渲染后 PI-3 会把它拦下（见 M3-E2E-PRE-DISABLED-STILL-BLOCKED）。",
  "unknown_never_pass": "PASS 只可能来自全部判定为 PASS 的集合；含 UNKNOWN/NOT_ASSESSABLE 的集合 overall 取 FAIL>UNKNOWN>NOT_ASSESSABLE（绝不为 PASS）。"
 },
