{
 "schema": "directorial-quality-truth-v1",
 "stage": "6-B/M1",
 "purpose": "Directorial Quality（DQ-1…DQ-8，DQ-7 为总评）**冻结真值集**：覆盖授权点名的 7 个覆盖项（Hook／素材重复／静态镜头／场景变化密度／视觉语义支撑／视觉高潮／Outro），逐项固化 PASS/FAIL/UNKNOWN/NOT_ASSESSABLE、阈值边界、**机械可测 vs 需要语义/人审**的分类，以及每个 FAIL 必须具备可回溯证据锚点的契约。",
 "frozen_policy": {
  "max_asset_share": 0.35,
  "min_unique_assets": 6,
  "max_hold_s": 25.0,
  "max_over_hold_share": 0.2,
  "min_scene_changes_per_min": 2.0,
  "min_distinct_assets_in_core": 6,
  "max_hold_in_core_s": 25.0,
  "max_tail_silence_s": 5.0,
  "min_semantic_match_share": 0.5,
  "outro_keywords": [
   "感谢观看",
   "感谢收看",
   "订阅",
   "下期",
   "再见",
   "我们下期",
   "收束",
   "结语"
  ],
  "outro_last_scenes": 2,
  "core_keywords": [
   "AlphaGeometry",
   "Lean",
   "mathlib",
   "四色定理",
   "开普勒",
   "计算机",
   "机器",
   "形式化",
   "证明",
   "检查",
   "验证"
  ]
 },
 "coverage_map": {
  "note": "授权书第 2 条的 7 个覆盖项 → DQ 指标的映射（DQ-1…DQ-7 沿用 6-A/M1 定义；DQ-8 为 6-B/M1 新增以闭合『视觉语义支撑』覆盖项）。",
  "Hook": "DQ-1",
  "素材重复/密度": "DQ-2（重复） + DQ-4（密度）",
  "静态镜头": "DQ-3",
  "场景变化": "DQ-4",
  "视觉语义支撑": "DQ-8（逐镜，复用既有只读证据）",
  "视觉高潮": "DQ-5（结构项=代理指标；语义项单列）",
  "Outro": "DQ-6（结构项 + 语义项单列）",
  "总评": "DQ-7"
 },
 "mechanical_vs_semantic": {
  "mechanical": [
   "DQ-2",
   "DQ-3",
   "DQ-4"
  ],
  "semantic": [
   "DQ-1",
   "DQ-8",
   "DQ-5.semantic_state",
   "DQ-6.semantic_state"
  ],
  "note": "机械项可直接由时间轴/素材/成片测量复算；语义项**只复用既有只读证据**（4-B/5-A/5-D/Judge），无证据 → NOT_ASSESSABLE，证据不足 → UNKNOWN，**UNKNOWN 绝不并入 PASS**；『是否有视觉高潮/画面是否真的支撑旁白』的最终人文判断不在 DQ 能力内，DQ 只做可度量代理 + 逐镜证据定位。"
 },
 "fail_evidence_contract": {
  "note": "6-B/M1 契约：**任何 FAIL 的返回必须带非空 `findings`**，且每个 finding 至少含 ①scene_id / asset_id / [start_s,end_s] 时间区间 / 证据层名 之一，使人工可直接定位复核。",
  "required_anchor_keys_any_of": [
   "scene_id",
   "asset_id",
   "window",
   "scene_windows",
   "asset_ids",
   "scenes",
   "scene_ids",
   "core_scene_ids",
   "distinct_asset_ids",
   "tail_scenes",
   "layers",
   "freeze_profile",
   "last_scene"
  ],
  "cases_tagged": "凡 expect.state == FAIL 的用例，测试都会断言该契约"
 },
