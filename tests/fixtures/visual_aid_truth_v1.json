{
 "schema": "visual-aid-truth-v1",
 "stage": "6-E",
 "purpose": "为 `add_visual_aid` 的真实执行器冻结契约：spec schema、从 E2 冻结计划的确定性编译、渲染文本、fail-closed 规则。",
 "spec_schema": {
  "name": "visual-aid-spec-v1",
  "required_top": ["schema", "layout", "panels", "no_external_assets", "forbid_verbatim_quotes"],
  "required_panel": ["id", "title", "kind", "items", "source", "source_label"],
  "layouts": ["ladder_cards_positions", "panel_columns"],
  "panel_kinds": ["ladder", "cards", "positions", "timeline", "slots"],
  "max_panels": 4,
  "max_items_per_panel": 8,
  "max_cjk_quote_chars": 24,
  "wrap_cols": 46,
  "safe_bottom_fraction": 0.95
 },
 "e2_expected_spec": {
  "source": "phase6e_material_plan.json → items.E2.C_self_made_spec（逐字编译，不新增事实）",
  "layout": "ladder_cards_positions",
  "panels": ["P1", "P2", "P3"],
  "kinds": {"P1": "ladder", "P2": "cards", "P3": "positions"},
  "P1_title": "可检视程度阶梯（示意）",
  "P1_items": ["未核对原文", "转述（本片当前状态）", "逐字核对", "机器可逐步复核"],
  "P1_focus_item": "转述（本片当前状态）",
  "P2_title": "争论的两篇文献（元数据）",
  "P2_must_contain": ["The Four-Color Problem and Its Philosophical Significance",
                      "The Journal of Philosophy 76(2), p.57, Feb 1979",
                      "10.2307/2025976", "The Four-Color Theorem and Mathematical Proof",
                      "77(12), p.803, Dec 1980", "10.2307/2025806"],
  "P3_title": "两种立场（转述，不引原文）",
  "P3_items_count": 2,
  "source_labels": {"P1": "来源：本片 S05 旁白", "P2": "来源：Crossref 记录（DOI 已核验）",
                    "P3": "来源：本片 S06/S07 旁白（转述）"},
  "forbidden_asset_id": "asset_432cd85be6f1",
  "must_not_contain_on_screen": ["\"", "“", "”"],
  "no_external_assets": true
 },
 "fail_closed_expectations": [
  {"case": "spec 不是对象", "code": "VISUAL_AID_SPEC_NOT_OBJECT"},
  {"case": "schema 不符", "code": "VISUAL_AID_BAD_SCHEMA"},
  {"case": "布局非法", "code": "VISUAL_AID_BAD_LAYOUT"},
  {"case": "no_external_assets 为 false", "code": "VISUAL_AID_EXTERNAL_ASSET"},
  {"case": "forbid_verbatim_quotes 为 false", "code": "VISUAL_AID_VERBATIM_QUOTE"},
  {"case": "panel 数为 0 或 >4", "code": "VISUAL_AID_PANEL_COUNT"},
  {"case": "panel 缺少 source", "code": "VISUAL_AID_PANEL_MISSING_FIELD"},
  {"case": "panel id 重复", "code": "VISUAL_AID_PANEL_DUPLICATE_ID"},
  {"case": "items 为空", "code": "VISUAL_AID_PANEL_EMPTY"},
  {"case": "items 超过 8 条", "code": "VISUAL_AID_PANEL_TOO_MANY_ITEMS"},
  {"case": "行数过密（>14 行）", "code": "VISUAL_AID_PANEL_TOO_DENSE"},
  {"case": "文本含西文双引号", "code": "VISUAL_AID_VERBATIM_QUOTE"},
  {"case": "『』强调片段 >24 字", "code": "VISUAL_AID_LONG_QUOTE"},
  {"case": "spec 含 asset_id / 图片字段", "code": "VISUAL_AID_EXTERNAL_ASSET"},
  {"case": "spec 含被否决资产 id", "code": "VISUAL_AID_FORBIDDEN_ASSET"},
  {"case": "spec 含 URL", "code": "VISUAL_AID_EXTERNAL_ASSET"},
  {"case": "字体文件缺失", "code": "VISUAL_AID_FONT_MISSING"},
  {"case": "字体 sha256 与期望不符", "code": "VISUAL_AID_FONT_MISMATCH"},
  {"case": "plan 条目缺少 C_self_made_spec.panels", "code": "VISUAL_AID_PLAN_ITEM_INVALID"},
  {"case": "整幅面板进入字幕安全区", "code": "VISUAL_AID_UNSAFE_BOTTOM"}
 ],
 "executor_contract": {
  "action": "add_visual_aid",
  "spec_sources": ["params.visual_aid（内联）",
                   "params.spec_source = {path,item,sha256}（哈希绑定的冻结计划，确定性编译）"],
  "runtime_fail_closed_codes": ["VISUAL_AID_SPEC_REQUIRED", "VISUAL_AID_SPEC_MISSING",
                                "VISUAL_AID_SPEC_SHA_MISMATCH", "VISUAL_AID_SPEC_UNREADABLE",
                                "VISUAL_AID_SPEC_ITEM_MISSING", "VISUAL_AID_WINDOW_REQUIRED"],
  "invariants": ["无外部素材（no_external_assets=true 且 spec 中无素材字段/URL）",
                 "渲染文本无直接引语标记且『』强调片段 ≤24 字",
                 "每条内容绑定 source（审计）；画面只渲染 source_label 短标签",
                 "叠加层不得进入底部 5% 字幕安全区",
                 "字体显式指定；给定期望 sha256 时校验",
                 "窗口内只重编码视频（叠加层 + 重烧字幕），未触及区段复制，母版整条音轨流复制",
                 "时长不变 / 音轨与母版逐字节一致 / 不 promote / 幂等由 M4-M5 门禁保证"],
  "evidence_keys": ["overlay_png", "sha256", "spec_sha256", "font", "panels", "rendered_text",
                    "safe_bottom_ok", "quote_free_verified"]
 },
 "scope_limits": {
  "e2_unchanged": true,
  "e3_e4_e5_unchanged": true,
  "no_execution_of_e2_in_this_task": true,
  "v9_c1_c4_db_untouched": true
 }
}
