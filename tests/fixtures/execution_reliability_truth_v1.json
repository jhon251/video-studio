 "concurrency_contract": {
  "serialization": "execute_batch(lock=...) 把『幂等复查 + 执行 + 落账』放入临界区 ⇒ 并发批次不会交错写链",
  "same_proposal_two_threads": "一条 SUCCEEDED、另一条 BLOCKED_ALREADY_EXECUTED（不重复执行）",
  "disjoint_two_threads": "两条都 SUCCEEDED，台账 seq 连续唯一、链完整",
  "boundary": "跨进程无锁时，幂等判定与落账之间存在竞态 ⇒ 见 boundary_notes"
 },
 "boundary_notes": {
  "batch_is_the_concurrency_unit": "冲突判定以**提交批次**为单位（批次 = 同时提交执行的一组已批准方案）；跨批次的同一方案由幂等门禁兜底。",
  "symmetric_blocking": "参与冲突的方案**全部**被阻断（不挑选先后、不自动合并）；需人工重新批准后方可再次提交。",
  "conservative_asset_rule": "同一 asset_id（即使窗口不相交）也判冲突 ⇒ 宁可多阻断，绝不自动合并。",
