{
 "schema": "human-review-truth-v1",
 "stage": "6-B/M2",
 "purpose": "Human Review Bridge 冻结真值集：固化 DQ finding → 人工决策（ACCEPT/REJECT/DEFER）的**闭环契约** —— 字段完备性、1:1 可追溯、UNKNOWN 保守路由、append-only 台账、零执行（REJECT 仅建议）与真实 v9 闭环期望。",
 "decision_vocabulary": [
  "ACCEPT",
  "REJECT",
  "DEFER"
 ],
 "decision_semantics": {
  "ACCEPT": "人工确认该 finding 不成立或可接受（不修改任何东西）",
  "REJECT": "人工确认该 finding 成立且**建议需要修改**（本阶段不执行修改）",
  "DEFER": "暂缓 / 需人工复核 / 待补证据（UNKNOWN、NOT_ASSESSABLE 一律走此路径）"
 },
 "required_decision_fields": [
  "finding_id",
  "decision",
  "reason",
  "decided_by",
  "provenance"
 ],
 "unknown_policy": {
  "unprovable_states": [
   "UNKNOWN",
   "NOT_ASSESSABLE"
  ],
  "default_routing": "DEFER",
  "default_routing_policy": "policy:unknown_requires_human",
  "accept_forbidden": true,
  "no_auto_pass": true
 },
 "non_execution_contract": {
  "executed_actions_must_be_empty": true,
  "executes_changes": false,
  "reject_means_recommendation_only": true,
  "forbidden_static_patterns": [
   "write_artifact",
   "set_task_status",
   "TASK_BLOCKED",
   "INSERT ",
   "UPDATE ",
   "DELETE ",
   "unlink(",
   "rmtree(",
   "write_bytes"
  ],
  "note": "本阶段禁止任何自动执行：决策只写 append-only 台账（人类审片证据），绝不触碰 timeline / 素材 / 字幕 / 旁白 / 成片，也不写 DB。"
 },
